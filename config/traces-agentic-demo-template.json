{
  "index_patterns": [
    "traces-agentic_demo.otel-*"
  ],
  "template": {
    "mappings": {
      "properties": {
        "data_stream.type": {
          "type": "constant_keyword",
          "value": "traces"
        }
      }
    },
    "settings": {
      "index.final_pipeline": "agentic-demo-otel-redact"
    },
    "data_stream_options": {
      "failure_store": {
        "enabled": false
      }
    }
  },
  "composed_of": [
    "traces@mappings",
    "traces@settings",
    "otel@mappings",
    "otel@settings",
    "traces-otel@mappings",
    "semconv-resource-to-ecs@mappings",
    "traces@custom",
    "traces-otel@custom",
    "ecs@mappings"
  ],
  "priority": 250,
  "_meta": {
    "description": "Agent Studio only: mandatory Elasticsearch ingest redaction"
  },
  "data_stream": {
    "hidden": false,
    "allow_custom_routing": false
  },
  "allow_auto_create": true,
  "ignore_missing_component_templates": [
    "traces@custom",
    "traces-otel@custom"
  ]
}
