# ── Elastic Cloud connection ──────────────────────────────────────────────────
# Create a serverless Elasticsearch (Observability) project at cloud.elastic.co
# then generate an API key with cluster:monitor + indices:all privileges.

ES_ENDPOINT="https://<your-project>.es.<region>.elastic.cloud"
ES_API_KEY="<base64-encoded-api-key>"

# Kibana endpoint (same project, different subdomain)
# Used by build_llm_dashboard.py and fill_apm_complete.py (alerts)
KIBANA_ENDPOINT="https://<your-project>.kb.<region>.elastic.cloud"
