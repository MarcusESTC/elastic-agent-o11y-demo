# Copy to .env and fill in your values
#   cp .env.example .env

GEMINI_API_KEY=your-gemini-api-key-here
ES_ENDPOINT=https://<deployment-id>.es.<region>.elastic.cloud
ES_API_KEY=your-elastic-api-key-here
OTEL_EXPORTER_OTLP_ENDPOINT=https://<managed-otlp-endpoint>
KIBANA_ENDPOINT=https://<your-kibana-endpoint>
# Optional: managed Elasticsearch bulk URL for log shippers, not OTLP or queries.
ELASTIC_BULK_ENDPOINT=https://<managed-otlp-endpoint>/_es

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_B=gemini-2.5-flash-lite
# Read-only configuration/proof and optional knowledge retrieval credential.
ES_READ_API_KEY=
ES_KNOWLEDGE_INDEX=agentic-demo-knowledge
# Install config/pii-redact-otel.json and demo templates with scripts/setup-ingestion.py.
PORT=5601
